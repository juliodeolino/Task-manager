<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="550.0" prefWidth="700.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.taskmanager.controller.MainController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="TaskManager - Gerenciador de Tarefas" />
      
      <!-- Tabela para listar as tarefas -->
      <TableView fx:id="tabelaTarefas" prefHeight="260.0" prefWidth="670.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
          <TableColumn fx:id="colTitulo" prefWidth="180.0" text="Título" />
          <TableColumn fx:id="colDescricao" prefWidth="320.0" text="Descrição" />
          <TableColumn fx:id="colStatus" prefWidth="100.0" text="Concluída" />
        </columns>
      </TableView>

      <!-- Formulário de Cadastro / Edição -->
      <VBox spacing="8.0">
         <children>
            <HBox spacing="10.0">
               <children>
                  <TextField fx:id="txtTitulo" promptText="Título da tarefa..." HBox.hgrow="ALWAYS" />
                  <CheckBox fx:id="chkConcluida" mnemonicParsing="false" text="Concluída" />
               </children>
            </HBox>
            <TextArea fx:id="txtDescricao" prefHeight="60.0" promptText="Descrição da tarefa..." wrapText="true" />
         </children>
      </VBox>

      <!-- Barra de Ações com os Botões -->
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#adicionarTarefa" text="Salvar Tarefa" />
            <Button mnemonicParsing="false" onAction="#marcarConcluida" text="Marcar Concluída" />
            <Button mnemonicParsing="false" onAction="#removerTarefa" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Remover" />
         </children>
      </HBox>
   </children>
</VBox>